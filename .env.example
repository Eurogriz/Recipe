# -----------------------------------------------------------------------------
# Formulation Workbench — sample environment file.
# Copy to .env and adjust for your environment. Never commit real secrets.
# All variables are prefixed with FW_ and consumed by AppSettings.
# -----------------------------------------------------------------------------

# development | staging | production
FW_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
FW_LOG_LEVEL=INFO
FW_LOG_JSON=true

# ---- Database ----------------------------------------------------------------
# Local SQLite (unencrypted):
FW_DATABASE_URL=sqlite+aiosqlite:///./data/formulation.db
# Encrypted SQLite (requires the [sqlcipher] extra and a real key):
# FW_DATABASE_URL=sqlite+aiosqlite:///./data/formulation.db
# FW_ENCRYPTION_KEY_HEX=<generate with: formulation-workbench generate-key>

# PostgreSQL (production):
# FW_DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/formulation

# ---- HTTP API ----------------------------------------------------------------
FW_API_HOST=0.0.0.0
FW_API_PORT=8000
# Static bearer token — /recipes* require Authorization: Bearer <token>.
# Empty in dev only; production requires either FW_API_TOKEN or FW_JWT_SECRET.
FW_API_TOKEN=

# JWT authentication (preferred).  Set the secret (>= 32 chars for HS256)
# and optionally the issuer.  Tokens must carry an `exp` claim by default.
FW_JWT_SECRET=
FW_JWT_ALGORITHM=HS256
FW_JWT_ISSUER=
FW_JWT_REQUIRE_EXP=true

# Optional: comma-separated list of allowed CORS origins.
# FW_API_CORS_ORIGINS=["https://app.example.com"]

# ---- Rate limiting -----------------------------------------------------------
FW_RATE_LIMIT_ENABLED=true
FW_RATE_LIMIT_PER_MINUTE=120

# ---- ML models ---------------------------------------------------------------
# Where trained RandomForest regressors are stored (pickle + JSON metadata).
# Should be a writable directory backed by durable storage in production.
FW_MODEL_DIR=./data/models

# ---- Observability -----------------------------------------------------------
FW_METRICS_ENABLED=true
# OpenTelemetry collector endpoint (leave blank to disable OTLP export).
# Requires the [observability] extra: pip install formulation-workbench[observability]
FW_OTLP_ENDPOINT=
FW_OTEL_SERVICE_NAME=formulation-workbench
